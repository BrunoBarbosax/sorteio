# ============================================================
# GORJETA 77 LUKAS - Variaveis de ambiente (exemplo)
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no controle de versao.
# ============================================================

# Ambiente: development | production | test
NODE_ENV=development

# Porta do servidor (em provedores como Render/Railway, use a porta indicada por eles)
PORT=4000

# ------------------------------------------------------------------
# Banco de dados
# ------------------------------------------------------------------
# db client: sqlite (desenvolvimento local) ou postgres (producao)
DB_CLIENT=sqlite

# Caminho do arquivo SQLite (apenas quando DB_CLIENT=sqlite)
SQLITE_PATH=./data/gorjeta77.db

# String de conexao do PostgreSQL (obrigatoria quando DB_CLIENT=postgres)
# Exemplo Render: postgres://usuario:senha@host:5432/banco?sslmode=require
# DATABASE_URL=postgres://usuario:senha@localhost:5432/gorjeta77

# ------------------------------------------------------------------
# Administrador inicial
# Utilize estes valores no comando:  npm run admin:create
# Em producao, defina-os no painel da hospedagem e depois remova.
# ------------------------------------------------------------------
ADMIN_EMAIL=admin@gorjeta77.com
ADMIN_PASSWORD=TroquePorUmaSenhaForte123!
ADMIN_NAME=Administrador

# ------------------------------------------------------------------
# Seguranca e operacao
# ------------------------------------------------------------------
# Segure o IP real quando o app estiver atras de um proxy reverso (1 no Render, Railway, Fly, Nginx)
TRUST_PROXY=0

# Duracao da sessao administrativa, em horas
SESSION_TTL_HOURS=12

# Desativar limitacao de requisicoes (somente para testes automatizados)
RATE_LIMIT_DISABLED=0

# Origem publica do site (usada em links/compartilhamento e verificacao de origem)
# Exemplo: https://meusorteio.com.br
PUBLIC_ORIGIN=http://localhost:5173
